{
  "expo": {
    "name": "Intra Interiors",
    "slug": "intra-interiors",
    "version": "1.0.0",
    "scheme": "intrainteriors",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.intrainteriors.erp",
      "infoPlist": {
        "NSCameraUsageDescription": "Take site photos for reports, tickets and documents.",
        "NSPhotoLibraryUsageDescription": "Attach photos to site reports, tickets and documents."
      }
    },
    "android": {
      "package": "co.intrainteriors.erp",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to site reports, tickets and documents.",
          "cameraPermission": "Take site photos for reports, tickets and documents."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://www.intrainteriors.co/cms/api"
    }
  }
}
